    "zoia:release:review-summary:quality-negative-controls": "node tests/workflow/scripts/run-release-review-summary-quality-negative-controls.mjs",
    "zoia:release:review-summary:overclaim-negative-controls": "node tests/workflow/scripts/run-release-review-overclaim-negative-controls.mjs",
