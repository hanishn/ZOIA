    "zoia:generate:patch:prompt-corpus-rollup": "node tests/workflow/scripts/run-generated-patch-prompt-corpus-rollup.mjs",
    "zoia:generate:patch:prompt-corpus-rollup:negative-controls": "node tests/workflow/scripts/run-generated-patch-prompt-corpus-rollup-negative-controls.mjs",
