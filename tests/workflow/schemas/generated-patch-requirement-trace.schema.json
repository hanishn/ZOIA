{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoia.generated-patch-requirement-trace.v1",
  "title": "ZOIA generated patch requirement trace",
  "type": "object",
  "required": ["schemaVersion", "patchId", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "zoia.generated-patch-requirement-trace.v1"
    },
    "patchId": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sourceText", "status", "moduleIds", "connectionIds", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceText": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["satisfied", "blocked"]
          },
          "moduleIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "connectionIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "object",
            "required": ["method", "expectedEvidence"],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": ["schema", "static-graph", "measured-audio", "measured-cv", "measured-midi", "manual-review"]
              },
              "expectedEvidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
