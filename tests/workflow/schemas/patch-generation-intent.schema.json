{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoia.patch-generation-intent.v1",
  "title": "ZOIA patch generation intent",
  "type": "object",
  "required": ["schemaVersion", "description", "tokens"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "zoia.patch-generation-intent.v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "requestedModalities": {
      "type": "array",
      "items": {
        "enum": ["audio", "cv", "midi", "control", "sample", "sequencer", "synth", "effect"]
      },
      "uniqueItems": true
    },
    "requiredFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    }
  }
}
