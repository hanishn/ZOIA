{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoia.generated-patch-graph.v1",
  "title": "ZOIA generated patch graph",
  "type": "object",
  "required": ["schemaVersion", "patchId", "name", "expectedModalities", "modules", "connections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "zoia.generated-patch-graph.v1"
    },
    "patchId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string"
    },
    "expectedModalities": {
      "type": "array",
      "items": {
        "enum": ["audio", "cv", "midi", "control", "sample", "sequencer", "synth", "effect"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "domain", "page", "grid", "params", "inputs", "outputs"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": ["audio", "cv", "midi", "control", "interface", "utility"]
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "grid": {
            "type": "integer",
            "minimum": 0,
            "maximum": 39
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "gain"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "$ref": "#/$defs/endpoint"
          },
          "to": {
            "$ref": "#/$defs/endpoint"
          },
          "gain": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["moduleId", "port"],
      "additionalProperties": false,
      "properties": {
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
